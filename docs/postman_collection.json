    {
      "name": "3. Signed webhooks",
      "description": "Uses the payment created in folder 2. Run in order.",
      "item": [
        {
          "name": "Webhook: SUCCESS (signed in pre-request script)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('webhookSecret') || pm.collectionVariables.get('webhookSecret');",
                  "if (!secret) throw new Error('Set webhookSecret (PROVIDER_WEBHOOK_SECRET from your .env) in a Postman environment first.');",
                  "const body = JSON.stringify({ eventId: 'evt_postman_' + Date.now(), paymentReference: pm.collectionVariables.get('paymentReference'), status: 'SUCCESS', providerPaymentId: 'prov_postman_1', occurredAt: new Date().toISOString() });",
                  "pm.collectionVariables.set('lastWebhookBody', body);",
                  "pm.variables.set('webhookBody', body);",
                  "pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('applied', () => pm.expect(pm.response.json().applied).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Provider-Signature",
                "value": "{{webhookSignature}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/payment-provider",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-provider"
              ]
            }
          }
        },
        {
          "name": "Webhook: same event again (duplicate)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('webhookSecret') || pm.collectionVariables.get('webhookSecret');",
                  "if (!secret) throw new Error('Set webhookSecret (PROVIDER_WEBHOOK_SECRET from your .env) in a Postman environment first.');",
                  "const body = pm.collectionVariables.get('lastWebhookBody');",
                  "pm.variables.set('webhookBody', body);",
                  "pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('duplicate', () => pm.expect(pm.response.json().duplicate).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Provider-Signature",
                "value": "{{webhookSignature}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/payment-provider",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-provider"
              ]
            },
            "description": "Re-sends the exact bytes of the previous webhook. Run it several times, then open Details: duplicateDeliveries goes up, the ledger does not."
          }
        },
        {
          "name": "Webhook: late PENDING (200 stale)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('webhookSecret') || pm.collectionVariables.get('webhookSecret');",
                  "if (!secret) throw new Error('Set webhookSecret (PROVIDER_WEBHOOK_SECRET from your .env) in a Postman environment first.');",
                  "const body = JSON.stringify({ eventId: 'evt_postman_' + Date.now(), paymentReference: pm.collectionVariables.get('paymentReference'), status: 'PENDING', providerPaymentId: 'prov_postman_1', occurredAt: new Date().toISOString() });",
                  "pm.collectionVariables.set('lastWebhookBody', body);",
                  "pm.variables.set('webhookBody', body);",
                  "pm.variables.set('webhookSignature', CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('stale', () => pm.expect(pm.response.json().reason).to.eql('STALE_EVENT'));"
                ]
