              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const { payment } = pm.response.json();",
                  "pm.collectionVariables.set('paymentId', payment.id);",
                  "pm.collectionVariables.set('paymentReference', payment.reference);",
                  "pm.test('starts PENDING', () => pm.expect(payment.status).to.eql('PENDING'));"
