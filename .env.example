# Copy to .env (never commit .env). All values here are placeholders.
NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Docker path (`npm run db:up`): keep these defaults (local-only container credentials).
# Neon / any PostgreSQL: paste your own URLs. On Neon use the DIRECT connection string
# (no "-pooler" in the host): migrations take session-level locks that a pooler breaks.
# Use ?sslmode=verify-full (pg already treats "require" that way but prints a warning for it).
# TEST_DATABASE_URL must be a different database: the test suite truncates every table.
DATABASE_URL=postgresql://experia:experia@localhost:5432/experia
TEST_DATABASE_URL=postgresql://experia:experia@localhost:5432/experia_test

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# The API refuses to start while these still contain "replace-me" (outside NODE_ENV=test).
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
PROVIDER_WEBHOOK_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Password for the three synthetic demo users created by `npm run seed` (demo only).
SEED_DEMO_PASSWORD=replace-me-demo-password

# --- Web / CORS -----------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# --- Mock payment provider (simulated external service) --------------------
PROVIDER_BASE_URL=http://localhost:4000/mock-provider
PROVIDER_TIMEOUT_MS=3000
MOCK_PROVIDER_ENABLED=true
MOCK_PROVIDER_DELAY_MS=0
MOCK_PROVIDER_TIMEOUT_RATE=0
MOCK_PROVIDER_ERROR_RATE=0
# Where the simulated provider sends its signed webhooks (this API).
MOCK_PROVIDER_WEBHOOK_URL=http://localhost:4000/api/webhooks/payment-provider

# --- Misc -------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MIN=10
LOG_LEVEL=info
