{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up -m migrations --envPath ../.env",
    "migrate:test": "node-pg-migrate up -m migrations --envPath ../.env -d TEST_DATABASE_URL",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:report": "cross-env NODE_ENV=test vitest run --reporter=verbose > ../docs/test-results.txt 2>&1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
